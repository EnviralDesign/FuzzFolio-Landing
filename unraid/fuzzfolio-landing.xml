<?xml version="1.0"?>
<Container version="2">
  <Name>FuzzFolio-Landing</Name>
  <Repository>ghcr.io/enviraldesign/fuzzfolio-landing:latest</Repository>
  <Registry>https://github.com/EnviralDesign/FuzzFolio-Landing/pkgs/container/fuzzfolio-landing</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/EnviralDesign/FuzzFolio-Landing/issues</Support>
  <Project>https://github.com/EnviralDesign/FuzzFolio-Landing</Project>
  <Overview>Static FuzzFolio landing page served by Nginx.</Overview>
  <Category>Network:Web</Category>
  <WebUI>http://[IP]:[PORT:80]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/EnviralDesign/FuzzFolio-Landing/main/unraid/fuzzfolio-landing.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/EnviralDesign/FuzzFolio-Landing/main/public/fuzzfolio-logo.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI" Target="80" Default="8787" Mode="tcp" Description="Local HTTP port for the landing page." Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <TailscaleStateDir/>
</Container>
